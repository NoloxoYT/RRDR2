<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <AssemblyName>RRDR.Host</AssemblyName>
    <RootNamespace>RRDR.Host</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <UseRealApi Condition="'$(UseRealApi)' == ''">false</UseRealApi>
    <DefineConstants Condition="'$(UseRealApi)' == 'true' and '$(TargetFramework)' == 'net48'">$(DefineConstants);REAL_API</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' != 'net48'">$(DefineConstants);MOCK_API</DefineConstants>
    <RustProfile Condition="'$(Configuration)' == 'Release'">release</RustProfile>
    <RustProfile Condition="'$(Configuration)' != 'Release'">debug</RustProfile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!--
    net10.0 is only used by the offline simulator and always references the mock.
    net48 defaults to the mock too, so the project builds without the real SDK.
    Build the shipping DLL with: dotnet build -c Release -p:UseRealApi=true
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48' or '$(UseRealApi)' != 'true'">
    <ProjectReference Include="..\ScriptHookRDRNetAPI.Mock\ScriptHookRDRNetAPI.Mock.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48' and '$(UseRealApi)' == 'true'">
    <Reference Include="ScriptHookRDRNetAPI">
      <HintPath>..\..\ScriptHookRDRNetAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="RRDR.Host.ini" CopyToOutputDirectory="PreserveNewest" />
    <None Include="RealisticDamages.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copy the Rust core if it has already been built. A missing core is not a
       build error: the script logs a clear load error instead of failing to load. -->
  <!-- Windows .NET Framework build: use the cross-compiled MSVC DLL (works from Linux too). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48' and Exists('..\..\..\rust\target\x86_64-pc-windows-msvc\$(RustProfile)\RealisticDamagesCore.dll')">
    <RustCoreFile Include="..\..\..\rust\target\x86_64-pc-windows-msvc\$(RustProfile)\RealisticDamagesCore.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48' and Exists('..\..\..\rust\target\$(RustProfile)\RealisticDamagesCore.dll')">
    <RustCoreFile Include="..\..\..\rust\target\$(RustProfile)\RealisticDamagesCore.dll" />
  </ItemGroup>
  <!-- net10.0 is the local simulator: use the native library for the current OS. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48' and !$([MSBuild]::IsOSPlatform('Windows')) and Exists('..\..\..\rust\target\$(RustProfile)\libRealisticDamagesCore.so')">
    <RustCoreFile Include="..\..\..\rust\target\$(RustProfile)\libRealisticDamagesCore.so" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48' and $([MSBuild]::IsOSPlatform('Windows')) and Exists('..\..\..\rust\target\$(RustProfile)\RealisticDamagesCore.dll')">
    <RustCoreFile Include="..\..\..\rust\target\$(RustProfile)\RealisticDamagesCore.dll" />
  </ItemGroup>

  <Target Name="CopyRustCore" AfterTargets="Build" Condition="'$(TargetFramework)' != '' and '@(RustCoreFile)' != ''">
    <Copy SourceFiles="@(RustCoreFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
