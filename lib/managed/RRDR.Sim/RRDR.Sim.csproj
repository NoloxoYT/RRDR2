<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RRDR.Sim</AssemblyName>
    <RootNamespace>RRDR.Sim</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RustProfile Condition="'$(Configuration)' == 'Release'">release</RustProfile>
    <RustProfile Condition="'$(Configuration)' != 'Release'">debug</RustProfile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RRDR.Host\RRDR.Host.csproj" />
    <ProjectReference Include="..\ScriptHookRDRNetAPI.Mock\ScriptHookRDRNetAPI.Mock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\RRDR.Host\RRDR.Host.ini" Link="RRDR.Host.ini" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\RRDR.Host\RealisticDamages.ini" Link="RealisticDamages.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows')) and Exists('..\..\..\rust\target\$(RustProfile)\libRealisticDamagesCore.so')">
    <RustCoreSim Include="..\..\..\rust\target\$(RustProfile)\libRealisticDamagesCore.so" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('..\..\..\rust\target\$(RustProfile)\RealisticDamagesCore.dll')">
    <RustCoreSim Include="..\..\..\rust\target\$(RustProfile)\RealisticDamagesCore.dll" />
  </ItemGroup>

  <Target Name="CopyRustCoreForSim" AfterTargets="Build" Condition="'@(RustCoreSim)' != ''">
    <Copy SourceFiles="@(RustCoreSim)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
